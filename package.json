{
  "name": "playwright-ts-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Demo E2E test framework (Playwright + TypeScript, Page Object Model) against the public practice site saucedemo.com",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.12.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.73.0"
  }
}
